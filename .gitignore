# Publish the full skin only; new top-level files require explicit inclusion.
/*
!/.gitignore
!/README.md
!/ASSETS.md
!/LICENSE
!/package.json
!/package-lock.json
!/cordis.patch.yml
!/playwright.config.mjs
!/src/
!/lib/
!/assets/
!/scripts/
!/tests/
!/docs/
!/release/

/assets/*
!/assets/nicole-pv-frames/
!/assets/nicole-pv-clean/

/scripts/*
!/scripts/build.mjs
!/scripts/prepare-pv-assets.mjs
!/scripts/setup-lab.mjs
!/scripts/verify-dsh.mjs
!/scripts/audit-releases.mjs

/docs/*
!/docs/development.md
!/docs/screenshots/
/docs/screenshots/*
!/docs/screenshots/dsh-pv-0.3.0-light.png
!/docs/screenshots/dsh-pv-0.3.0-dark.png
!/docs/screenshots/dsh-pv-0.3.0-settings-light.png

# Keep local historical packages and source archives out of Git.
/release/*
!/release/dsh-skin-genshin-nicole-0.3.1.tgz
!/release/dsh-skin-genshin-nicole-0.3.1.sha256

# Block sensitive/generated files inside allowed directories as well.
node_modules/
.pnpm-store/
.lab/
.git/
.codex/
.agents/
test-results/
playwright-report/
.auth/
.env
.env.*
.npmrc
.credentials.yaml
.anonymous-user-id
*browser-state*.json
*storage-state*.json
*cookies*.json
*cookies*.txt
*.pem
*.key
*.p12
*.pfx
*.log
*.har
*.map
*.mp4
*.webm
*.zip
.DS_Store
Thumbs.db
