{
  "name": "dsh-skin-genshin-nicole",
  "version": "0.3.6",
  "description": "原神 · 尼可 PV 背景队列 — 14 张去字幕截图、前后切换与可配置停留时间",
  "type": "module",
  "license": "MIT",
  "author": "Wedomizing",
  "homepage": "https://github.com/Wedomizing/Dsh_genshin_nicole_skin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wedomizing/Dsh_genshin_nicole_skin.git"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.1.2-rc.1 <0.2.0-0"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "ASSETS.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ],
      "platform": "web",
      "immediately": true
    },
    "marketplace": {
      "profiles": [
        "web",
        "desktop"
      ],
      "requiresBuildApproval": false,
      "requiresRestart": true,
      "manualSteps": false
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh-skin",
    "theme",
    "genshin-impact",
    "nicole"
  ],
  "scripts": {
    "assets:prepare": "node scripts/prepare-pv-assets.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "pack:release": "npm run build && npm pack --pack-destination release",
    "test:browser": "playwright test tests/dsh.browser.spec.mjs",
    "verify:dsh": "node scripts/verify-dsh.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "esbuild": "0.28.2",
    "jsdom": "30.0.1",
    "sharp": "0.35.4"
  }
}
